     "why": "the content type the page sends is the one the server takes"
    },
    {
     "step": {
      "person": "I332737204849",
      "step_key": "fetch:1,3077::604036",
      "fields": {
       "revisions_json": {
        "is": null
       }
      }
     }
    }
   ]
  },
  {
